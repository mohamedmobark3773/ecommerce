{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.js", "src/**/*.mjs", "src/**/*.cjs"],
  "exclude": ["node_modules", "dist", "database", "logs", "uploads"]
}
